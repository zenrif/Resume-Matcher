# Resume Matcher Backend Configuration
# Copy this file to .env and update values as needed

# ===========================================
# LLM Provider Configuration
# ===========================================
# Supported providers: openai, anthropic, gemini, openrouter, deepseek, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here

# Optional: Custom API endpoint (required for Ollama, optional for others)
# LLM_API_BASE=http://localhost:11434

# ===========================================
# Server Configuration
# ===========================================
# Host and port for the backend server
HOST=0.0.0.0
PORT=8000

# Frontend URL - Used for PDF generation (must be accessible from backend)
# Update this if running frontend on a different port/host
FRONTEND_BASE_URL=http://localhost:3000

# ===========================================
# CORS Configuration
# ===========================================
# Allowed origins for cross-origin requests (JSON array format)
# Update this if running frontend on a different port/host
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===========================================
# Quick Reference: Changing Ports
# ===========================================
# If you change the BACKEND port (default 8000):
#   1. Update PORT above
#   2. Update frontend's NEXT_PUBLIC_API_URL to match
#
# If you change the FRONTEND port (default 3000):
#   1. Update FRONTEND_BASE_URL above
#   2. Update CORS_ORIGINS above to include the new URL

# ===========================================
# Auth & Multi-user Configuration
# ===========================================
# Secure flag for session cookie (set to false ONLY for localhost dev without HTTPS)
AUTH_COOKIE_SECURE=false

# Session duration in days
AUTH_SESSION_DAYS=30

# Bootstrap admin email (creates an initial admin and prints invite link on first startup)
ADMIN_EMAIL=admin@example.com

# Public base URL (used to generate bootstrap invite URL, falls back to FRONTEND_BASE_URL)
# PUBLIC_BASE_URL=https://cv.example.com

# Default daily AI limit for non-admin users
DEFAULT_DAILY_AI_LIMIT=30

# Set to true when running behind a reverse proxy (uses left-most X-Forwarded-For)
TRUST_PROXY=false

# Invite link lifetime in days
INVITE_TTL_DAYS=7

# Minimum password length
MIN_PASSWORD_LENGTH=10

# Interactive API docs (/docs, /redoc, /openapi.json) enabled (disabled by default in production)
DOCS_ENABLED=false
